/* Left palette: #EE4540 #C72C41 #801336 #510A32 #2D142C */

QMainWindow,
QWidget#appRoot,
QWidget#homePage,
QWidget#asciiPage,
QWidget#baseConverterPage,
QWidget#pixelPage,
QStackedWidget {
    background-color: #2D142C;
    color: #FCF4F7;
}

QWidget {
    color: #FCF4F7;
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 14px;
}

QFrame[card="true"] {
    background-color: #351630;
    border: 1px solid #510A32;
    border-radius: 14px;
}

QLabel[role="homeTitle"] {
    color: #FCF4F7;
    font-size: 34px;
    font-weight: 700;
}

QLabel[role="pageTitle"] {
    color: #FCF4F7;
    font-size: 27px;
    font-weight: 700;
}

QLabel[role="description"] {
    color: #CDBFC8;
    font-size: 15px;
}

QLabel[role="fieldLabel"] {
    color: #FCF4F7;
    font-size: 13px;
    font-weight: 600;
}

QLabel[role="eyebrow"] {
    color: #EE4540;
    font-size: 11px;
    font-weight: 700;
}

QLabel[role="status"] {
    min-height: 18px;
    padding: 4px 2px;
    background-color: transparent;
    color: #CDBFC8;
    font-size: 12px;
}

QLabel[role="status"][state="success"] {
    color: #FCF4F7;
}

QLabel[role="status"][state="error"] {
    padding: 6px 9px;
    background-color: #510A32;
    border-left: 3px solid #EE4540;
    color: #FCF4F7;
}

QPlainTextEdit {
    padding: 10px 12px;
    background-color: #2D142C;
    border: 1px solid #685064;
    border-radius: 8px;
    color: #FCF4F7;
    selection-background-color: #C72C41;
    selection-color: #FCF4F7;
}

QPlainTextEdit[monospace="true"] {
    font-family: "SF Mono", "Menlo", "Monaco", "Cascadia Mono", monospace;
}

QPlainTextEdit:focus {
    border: 2px solid #EE4540;
    padding: 9px 11px;
}

QPlainTextEdit[readOnly="true"] {
    background-color: #31152D;
    color: #E5D9E1;
}

QComboBox {
    min-height: 24px;
    padding: 8px 10px;
    background-color: #2D142C;
    border: 1px solid #685064;
    border-radius: 8px;
    color: #FCF4F7;
    selection-background-color: #C72C41;
    selection-color: #FCF4F7;
}

QComboBox:focus {
    padding: 7px 9px;
    border: 2px solid #EE4540;
}

QComboBox:disabled {
    background-color: #31152D;
    border-color: #47203F;
    color: #806B7A;
}

QComboBox::drop-down {
    width: 28px;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #351630;
    border: 1px solid #685064;
    color: #FCF4F7;
    selection-background-color: #C72C41;
    selection-color: #FCF4F7;
}

QPushButton {
    min-height: 24px;
    padding: 9px 14px;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #FCF4F7;
    font-size: 14px;
    font-weight: 600;
}

QPushButton[role="primary"] {
    background-color: #EE4540;
    border-color: #EE4540;
    color: #FFFFFF;
}

QPushButton[role="primary"]:hover {
    background-color: #C72C41;
    border-color: #C72C41;
}

QPushButton[role="primary"]:pressed {
    background-color: #801336;
    border-color: #801336;
}

QPushButton[role="primary"]:disabled {
    background-color: #5E3B55;
    border-color: #5E3B55;
    color: #A993A3;
}

QPushButton[role="navigation"] {
    background-color: transparent;
    border-color: #685064;
    color: #FCF4F7;
}

QPushButton[role="navigation"]:hover {
    background-color: #510A32;
    border-color: #801336;
}

QPushButton[role="navigation"]:pressed {
    background-color: #801336;
}

QPushButton[role="secondary"] {
    background-color: #351630;
    border-color: #685064;
    color: #FCF4F7;
}

QPushButton[role="secondary"]:hover {
    background-color: #510A32;
    border-color: #C72C41;
}

QPushButton[role="secondary"]:pressed {
    background-color: #801336;
    border-color: #EE4540;
}

QPushButton[role="tool"] {
    padding: 15px 18px;
    background-color: #351630;
    border-color: #510A32;
    border-radius: 10px;
    color: #FCF4F7;
    font-size: 15px;
    text-align: left;
}

QPushButton[role="tool"]:hover {
    background-color: #510A32;
    border-color: #C72C41;
}

QPushButton[role="tool"]:pressed {
    background-color: #801336;
    border-color: #EE4540;
}

QPushButton[role="tool"]:disabled {
    background-color: #31152D;
    border-color: #47203F;
    color: #806B7A;
}

QPushButton:focus {
    border: 2px solid #EE4540;
}

QLabel[role="metadata"] {
    color: #CDBFC8;
    font-size: 12px;
}

QLabel[preview="true"] {
    padding: 14px;
    background-color: #2D142C;
    border: 1px solid #685064;
    border-radius: 8px;
    color: #CDBFC8;
}

QSplitter::handle {
    width: 2px;
    margin: 6px;
    background-color: #685064;
}

QDialog,
QMessageBox {
    background-color: #2D142C;
    color: #FCF4F7;
}

QDialog QLabel,
QMessageBox QLabel {
    color: #FCF4F7;
}

QDialog QPushButton,
QMessageBox QPushButton {
    background-color: #351630;
    border-color: #685064;
    color: #FCF4F7;
}

QDialog QPushButton:hover,
QMessageBox QPushButton:hover {
    background-color: #510A32;
    border-color: #C72C41;
}

QScrollBar:vertical {
    width: 10px;
    margin: 2px;
    background-color: #2D142C;
}

QScrollBar::handle:vertical {
    min-height: 28px;
    background-color: #685064;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #C72C41;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    height: 10px;
    margin: 2px;
    background-color: #2D142C;
}

QScrollBar::handle:horizontal {
    min-width: 28px;
    background-color: #685064;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QToolTip {
    padding: 6px 8px;
    background-color: #510A32;
    border: 1px solid #801336;
    color: #FCF4F7;
}
